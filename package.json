{
  "name": "ciccio",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Ciccio: sala controllo per gli agenti Claude",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p companion/tsconfig.json",
    "companion": "tsx companion/src/main.ts",
    "companion:build": "bash companion/build.sh",
    "companion:mac": "bash companion/mac/build-app.sh",
    "companion:publish": "bash companion/publish.sh",
    "desktop:build": "bash desktop/build.sh",
    "desktop:publish": "bash desktop/publish.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "better-sqlite3": "^12.11.1",
    "dompurify": "^3.4.17",
    "fastify": "^5.12.7",
    "highlight.js": "^11.12.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.12",
    "thinking-orbs": "^0.3.2",
    "three": "0.186.1",
    "use-stick-to-bottom": "1.1.6",
    "ws": "^8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "node-gyp": "^13.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@12.4.1"
}
